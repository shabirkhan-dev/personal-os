{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["react", "nextjs", "import", "typescript", "unicorn", "oxc", "jsx-a11y"],
	"categories": {
		"correctness": "warn",
		"suspicious": "warn",
		"perf": "warn"
	},
	"ignorePatterns": ["**/.next", "**/dist"],
	"rules": {
		"react/exhaustive-deps": "warn",
		"react/rules-of-hooks": "error",
		"react/set-state-in-effect": "off",
		"react/no-deriving-state-in-effects": "off",
		"react/memo-dependencies": "off",
		"react/immutability": "off",
		"nextjs/no-img-element": "warn",
		"nextjs/no-head-element": "warn",
		"nextjs/no-document-import-in-page": "error",
		"nextjs/no-head-import-in-document": "error",
		"nextjs/google-font-display": "warn",
		"unicorn/prefer-node-protocol": "warn",
		"react/react-in-jsx-scope": "off",
		"import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
		"jsx-a11y/prefer-tag-over-role": "off"
	},
	"overrides": [
		{
			"files": ["apps/api/**/*.ts"],
			"rules": {
				"react/exhaustive-deps": "off",
				"react/rules-of-hooks": "off",
				"react-hooks/rules-of-hooks": "off",
				"nextjs/no-img-element": "off",
				"nextjs/no-head-element": "off"
			}
		},
		{
			"files": ["apps/web/**/*.ts", "apps/web/**/*.tsx", "apps/docs/**/*.ts", "apps/docs/**/*.tsx"],
			"rules": {
				"nextjs/no-before-interactive-script-outside-document": "warn"
			}
		},
		{
			"files": ["packages/domain/**/*.ts"],
			"rules": {
				"unicorn/no-array-sort": "off"
			}
		},
		{
			"files": ["apps/mobile/**/*.ts", "apps/mobile/**/*.tsx"],
			"rules": {
				"react/no-array-index-key": "off",
				"react/no-unstable-nested-components": ["warn", { "allowAsProps": true }],
				"react/memo-dependencies": "off",
				"react-hooks/exhaustive-deps": "off",
				"react/exhaustive-deps": "off",
				"import/no-unassigned-import": "off",
				"nextjs/no-img-element": "off",
				"nextjs/no-head-element": "off",
				"nextjs/no-document-import-in-page": "off",
				"nextjs/no-head-import-in-document": "off",
				"nextjs/google-font-display": "off",
				"nextjs/no-before-interactive-script-outside-document": "off",
				"unicorn/no-array-sort": "off",
				"unicorn/no-array-reverse": "off"
			}
		}
	]
}
