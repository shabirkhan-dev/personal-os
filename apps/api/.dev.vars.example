# Local secrets and overrides for `wrangler dev`. Copy to .dev.vars (git-ignored).
ENVIRONMENT=development
# mock answers every AI task without a key; set openai_compatible + OPENAI_API_KEY for real ones.
AI_PROVIDER=mock
JWT_SECRET=development-only-jwt-secret-change-me-please
AUTH_TOKEN_SECRET=development-only-auth-token-secret-change-me
# Without a Resend key, sign-in codes are returned in the response (development only).
# RESEND_API_KEY=re_...
# OPENAI_API_KEY=sk-...
# Avatar uploads: an R2 API token with Object Read & Write on the bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://assets.example.com
