{
	"name": "@personal-os/api",
	"version": "0.1.0",
	"private": true,
	"description": "Personal OS API on Cloudflare Workers (Hono): auth, profile, onboarding, sync, AI",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "wrangler deploy --dry-run --outdir dist",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings src/worker-env.d.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"@personal-os/domain": "workspace:*",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.16",
		"jose": "^6.2.15",
		"postgres": "^4.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261106.1",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0",
		"wrangler": "^4.158.0"
	}
}
