{
	// Personal OS API on Cloudflare Workers. Deploy with Workers Builds (root directory
	// `apps/api`, deploy command `npx wrangler deploy`) or `bun --cwd=apps/api run deploy`.
	// Setup, secrets and the one-time Hyperdrive and R2 steps: /docs/deploy.
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "personal-os-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Daily housekeeping: old sign-in codes, ended sessions and AI usage rows (src/index.ts).
	"triggers": { "crons": ["17 3 * * *"] },
	"dev": { "port": 4000, "ip": "0.0.0.0" },

	// Only generic settings live here; the repo is public. Values for your own deployment
	// (AUTH_EMAIL_FROM, OPENAI_BASE_URL, OPENAI_MODEL, R2_ACCOUNT_ID, R2_PUBLIC_URL) are set in
	// the dashboard (Worker → Settings → Variables and Secrets); `keep_vars` stops a deploy from
	// deleting them. Secrets (JWT_SECRET, AUTH_TOKEN_SECRET, RESEND_API_KEY, OPENAI_API_KEY,
	// R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) go there too, or `wrangler secret put`. Locally,
	// everything comes from `.dev.vars` (copy `.dev.vars.example`).
	"keep_vars": true,
	"vars": {
		"ENVIRONMENT": "production",
		"APP_NAME": "Personal OS",
		"AI_PROVIDER": "openai_compatible",
		"R2_BUCKET_NAME": "personal-os-assets",
	},

	// Postgres (Neon) through Hyperdrive. Create it once (dashboard → Hyperdrive, or
	//   bunx wrangler hyperdrive create personal-os-db --connection-string="<Neon URL>")
	// and paste the id. The id is not a credential: the connection string lives in Cloudflare,
	// and the id is only usable from inside your own account. Forks put their own id here. `localConnectionString` is what `wrangler dev` uses.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "037e090d79784cac818deb6acb9177e2",
			"localConnectionString": "postgresql://personal_os:personal_os@localhost:5433/personal_os",
		},
	],

	// Images and other assets. The app uploads straight to this bucket with a presigned URL.
	"r2_buckets": [{ "binding": "ASSETS", "bucket_name": "personal-os-assets" }],

	// Per-key limits (IP or user). namespace_id is any number unique within the account.
	"ratelimits": [
		{ "name": "AUTH_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
		{ "name": "AI_LIMITER", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } },
		{ "name": "SYNC_LIMITER", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } },
		{ "name": "UPLOAD_LIMITER", "namespace_id": "4104", "simple": { "limit": 5, "period": 60 } },
	],
}
