# Personal OS API base URL (no path).
# - Hosted: the Worker's URL, e.g. https://personal-os-api.<you>.workers.dev
# - Local (`bun --cwd=apps/api run dev`): your computer's LAN IP on the same Wi-Fi as the phone,
#   e.g. http://192.168.1.20:4000. localhost hangs on a physical phone.
# If unset, the app uses Metro's host (Expo LAN) or the Android emulator's 10.0.2.2, port 4000.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
