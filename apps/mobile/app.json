{
  "expo": {
    "name": "Personal OS",
    "slug": "personal-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shabirkhandev.personalos",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Personal OS uses the microphone when you talk to set up or ask “Hey OS”."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shabirkhandev.personalos"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#141414"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Personal OS uses the microphone when you talk to set up or ask “Hey OS”.",
          "speechRecognitionPermission": "Personal OS turns what you say into text so it can fill in your answers.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2D7CF6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Personal OS uses your photos when you attach one to a meal or skin check-in.",
          "cameraPermission": "Personal OS uses the camera for meal and skin check-in photos."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Personal OS counts your steps for the Workout module."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Personal OS uses your location to work out prayer times and the Qibla direction where you are."
        }
      ],
      "./plugins/with-talk-shortcut"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ebd7c656-cf18-46ce-80f3-0fc034481946"
    },
    "backgroundColor": "#141414",
    "extra": {
      "eas": {
        "projectId": "ebd7c656-cf18-46ce-80f3-0fc034481946"
      }
    }
  }
}
