{
  "expo": {
    "name": "Personal OS",
    "slug": "personal-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shabirkhandev.personalos",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Personal OS uses the microphone when you talk to set up or ask \u201cHey OS\u201d."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D7CF6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shabirkhandev.personalos"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#141414"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Personal OS to access your photos for your profile avatar."
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ebd7c656-cf18-46ce-80f3-0fc034481946"
    },
    "backgroundColor": "#141414",
    "extra": {
      "eas": {
        "projectId": "ebd7c656-cf18-46ce-80f3-0fc034481946"
      }
    }
  }
}
