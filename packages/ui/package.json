{
	"name": "@starter/ui",
	"version": "0.0.0",
	"private": true,
	"sideEffects": ["**/*.css"],
	"type": "module",
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./components/mobile": "./src/components/mobile/index.ts",
		"./components/mobile/*": "./src/components/mobile/*.tsx",
		"./components/*": "./src/components/*.tsx",
		"./lib/*": "./src/lib/*.ts",
		"./hooks/*": "./src/hooks/*.ts",
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@shadcn/react": "^0.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"motion": "^13.4.6",
		"recharts": "3.10.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@hugeicons/react-native": "^1.0.16",
		"@starter/typescript-config": "workspace:*",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react-native": "0.88.0-rc.3",
		"react-native-reanimated": "4.7.0",
		"typescript": "^7.0.2",
		"uniwind": "^1.12.1"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"react-native": "*",
		"react-native-reanimated": "*",
		"@hugeicons/react-native": "*",
		"uniwind": "*"
	},
	"peerDependenciesMeta": {
		"react-dom": {
			"optional": true
		},
		"react-native": {
			"optional": true
		},
		"react-native-reanimated": {
			"optional": true
		},
		"@hugeicons/react-native": {
			"optional": true
		},
		"uniwind": {
			"optional": true
		}
	}
}
